// Configuración básica
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- AUTENTICACIÓN Y ROLES ---

enum Role {
  ADMIN       // Gestiona stock, recetas y usuarios
  TRABAJADOR  // Atiende local y cocina
  DELIVERY    // Solo ve pedidos para repartir
  CLIENTE     // (Opcional) para ver menú o estado
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  role      Role     @default(TRABAJADOR)
  activo    Boolean  @default(true)
  pedidos   Pedido[] @relation("RepartidorPedidos") // Para el rol DELIVERY

  // Movimientos de caja que registro esta persona. Es solo el lado inverso de
  // la FK; borrar un usuario NO borra su historial de caja (la relacion es
  // SET NULL del otro lado, ver CajaMovimiento.registradoPorId).
  movimientosCaja CajaMovimiento[] @relation("MovimientosRegistrados")

  createdAt DateTime @default(now())

  // El splash "Bienvenido {nombre}" del Home admin se muestra una sola vez.
  // Arranca en false para todos (los usuarios existentes lo ven una vez) y lo
  // marca POST /users/me/bienvenida-vista cuando TERMINA la animación, no el
  // SSR que la sirve: si lo marcara el GET, un prefetch de /admin consumiría
  // el flag sin que nadie llegara a ver el splash.
  bienvenidaVista Boolean @default(false)

  /**
   * Ultimo login exitoso. Null en los usuarios que nunca entraron (y en todos
   * los que ya existian cuando se agrego la columna: el dato no es
   * reconstruible hacia atras, no hay registro de logins previos).
   * Lo escribe `AuthService.login`, no el guard: se trata de "inicio de
   * sesion", no de "ultima actividad". Un token de 10hs haria que el segundo
   * significado escribiera en cada request.
   */
  lastLoginAt DateTime?
}

// --- GESTIÓN DE STOCK (INSUMOS) ---

model Insumo {
  id String @id @default(uuid())
  nombre String
  stockActual Float @default(0)
  stockMinimo Float @default(5)
  unidadMedida String
  recetas ProductoReceta[]
  activo Boolean @default(true)

  // ✅ NUEVO: proveedor opcional
  proveedorId String?
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id])

  // ✅ NUEVO: extras que usan este insumo
  extras Extra[]

  // ✅ NUEVO: historial de movimientos de stock
  movimientos StockMovimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Postgres no indexa solo las columnas de FK. Lo usa el filtro por proveedor
  // del panel de Insumos y la validacion de borrado de Proveedor, que cuenta
  // cuantos insumos le cuelgan.
  @@index([proveedorId])
}

model StockMovimiento {
  id           String   @id @default(uuid())
  insumoId     String?
  insumo       Insumo?  @relation(fields: [insumoId], references: [id])
  extraId      String?
  extra        Extra?   @relation(fields: [extraId], references: [id])
  aderezoId    String?
  aderezo      Aderezo? @relation(fields: [aderezoId], references: [id])
  tipo         String   // DESCUENTO_PEDIDO | AJUSTE_MANUAL | REPOSICION
  cantidad     Float    // negativo si se descontó, positivo si se repuso
  stockAntes   Float
  stockDespues Float
  pedidoId     String?
  motivo       String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([insumoId])
  @@index([extraId])
  @@index([aderezoId])
  @@index([createdAt])

  // Historial de UN insumo ordenado por fecha (el modal del panel) y su
  // consumo dentro de un rango. El simple de [insumoId] no alcanza: obliga a
  // ordenar despues de leer todas las filas del insumo.
  @@index([insumoId, createdAt])
  // Lo mismo para las salsas: el historial de UNA salsa por fecha y su consumo
  // dentro de una ventana, que es lo que pide /admin/aderezos.
  @@index([aderezoId, createdAt])
  // Reporte de consumo por rango: igualdad en tipo + rango en fecha. La
  // columna de igualdad va primera para que el rango caiga sobre un tramo
  // contiguo del indice.
  @@index([tipo, createdAt])
}

model Proveedor {
  id        String   @id @default(uuid())
  nombre    String   @unique
  telefono  String?
  email     String?
  notas     String?
  activo    Boolean  @default(true)

  // ✅ un proveedor tiene muchos insumos
  insumos   Insumo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- CATEGORIAS DE LOS PRODUCTOS ---
model Categoria {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  cantExtrasGratis    Int     @default(2)
  sinExtrasNiAderezos Boolean @default(false)
  productos        Producto[]
  preciosAderezos  AderezoPrecio[]
  preciosExtras    ExtraPrecio[]
  extrasCategoria  ExtraCategoria[]
  aderezosCategoria AderezoCategoria[]
  consumosAderezo  AderezoConsumo[]
  consumosExtra    ExtraConsumo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- PRODUCTOS Y RECETAS DINÁMICAS ---

model Producto {
  id                  String   @id @default(uuid())
  nombre              String
  precio              Float
  esParaVenta         Boolean  @default(true)
  activo              Boolean  @default(true)
  descripcion         String?
  imagenUrl           String?
  codigo              String?  @unique
  tiempoPreparacionMin Int?
  categoriaId         String?
  categoria           Categoria? @relation(fields: [categoriaId], references: [id])
  receta              ProductoReceta[]
  detalles            PedidoDetalle[]
  ofertaProductos     OfertaProducto[]
  grupoOpciones       GrupoOpcion[]
}

// Tabla intermedia para la "Receta" (Escandallo)
model ProductoReceta {
  id          String   @id @default(uuid())
  productoId  String
  insumoId    String
  cantidad    Float    // Ej: 4 (para 4 medallones)
  
  producto    Producto @relation(fields: [productoId], references: [id])
  insumo      Insumo   @relation(fields: [insumoId], references: [id])

  // Nada impedia cargar dos veces el mismo insumo en un producto, y el
  // descuento de stock al vender recorre la receta fila por fila: la linea
  // duplicada descontaba doble sin que nadie lo viera. La receta es un set
  // (insumo -> cantidad), asi que la unicidad vive en la base y no solo en
  // el DTO.
  @@unique([productoId, insumoId])

  // Postgres no indexa las columnas de FK por su cuenta y esta tabla solo
  // tenia la PK. `insumoId` es el que hacia seq scan (buscar que productos
  // usan un insumo); `productoId` queda cubierto ademas por la unique de
  // arriba, que lo lleva de columna lider - ver la nota en la migracion.
  @@index([productoId])
  @@index([insumoId])
}

