// --- PEDIDOS Y DELIVERY ---


enum TipoPedido {
  LOCAL
  DELIVERY
  RETIRO
}

enum EstadoPedido {
  PENDIENTE
  EN_PREPARACION
  LISTO_PARA_RETIRAR
  EN_CAMINO
  ENTREGADO
  CANCELADO
  PROBLEMA_DIRECCION
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

model Pedido {
  id           String        @id @default(uuid())
  tipo         TipoPedido    @default(LOCAL)
  estado       EstadoPedido  @default(PENDIENTE)
  total        Float         @default(0)

  // Credencial de tracking pública, separada del `id` interno. Null en pedidos
  // creados antes de esta migración (siguen accesibles solo por `id`, ver
  // PedidosService.verificarTrackingAcceso).
  trackingCode String?       @unique

  nombreCliente   String?
  apellidoCliente String?
  numeroCliente   String?
  metodoPago      MetodoPago?

  direccion            String?
  costoEnvio           Float         @default(0)
  motivoCancelacion    String?
  canceladoPor         Role?

  direccionLat         Float?
  direccionLng         Float?
  direccionFormateada  String?
  piso                 String?
  departamento         String?
  referencias          String?
  notasRepartidor      String?
  shippingZoneName String?
  shippingReason String?
  direccionPrecision String?

  repartidorId String?
  repartidor   User?         @relation("RepartidorPedidos", fields: [repartidorId], references: [id])

  demoraMinutosSnapshot Int?

  detalles         PedidoDetalle[]
  ofertasAplicadas PedidoOferta[]
  movimientosCaja  CajaMovimiento[]
  createdAt        DateTime      @default(now())

  // Hasta acá Pedido no tenía NINGÚN índice: cualquier consulta que filtrara
  // por estado o fecha hacía seq scan sobre la tabla entera. Los tres cubren
  // lo que se consulta de verdad: el monitor y el Home filtran por estado,
  // los listados y resúmenes ordenan por fecha, y el bloque de delivery
  // pendientes filtra por tipo + estado.
  @@index([estado])
  @@index([createdAt])
  @@index([tipo, estado])
}

model PedidoDetalle {
  id String @id @default(uuid())
  pedidoId String
  productoId String
  cantidad Int
  aderezos Aderezo[]

  precioUnitario Float @default(0)
  sinExtras Boolean @default(false)

  extras Json?

  subtotal Float
  notas String?

  comboId String?          // Id de la oferta-combo (snapshot, sin FK)
  comboInstanciaId String? // Agrupa las líneas de UN combo dentro del pedido
  comboNombre String?      // Nombre del combo stampeado al crear (snapshot, no depende de FK)

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
  ofertaAplicada PedidoOferta[]

  @@index([comboInstanciaId])

  // Postgres no indexa las columnas de FK por su cuenta, y estas dos venian
  // sin nada desde el init. Las usa toda la seccion de Estadisticas: el join
  // contra Pedido para acotar por rango de fechas, y el agrupado por producto
  // del top y del maridaje. `productoId` ademas cubre GET /productos/:id/stats,
  // que ya estaba en produccion consultandola sin indice.
  @@index([pedidoId])
  @@index([productoId])
}

// --- GESTIÓN DE EXTRAS ---

model Extra {
  id               String   @id @default(uuid())
  nombre           String   @unique
  precio           Float    @default(500)
  unidadMedida     String   @default("un")
  stockActual      Float    @default(0)

  // Umbral de aviso PROPIO del extra, mismo criterio que Insumo.stockMinimo:
  // no hay un umbral global del que colgarse, cada extra declara el suyo. El
  // default de la columna existe para que la migracion pueda agregarla NOT
  // NULL sin reescribir la tabla; el alta lo pide obligatorio (ver CrearExtraDto).
  stockMinimo      Float    @default(10)

  activo           Boolean  @default(true)
  esGlobal         Boolean  @default(false)
  esPremium        Boolean  @default(false)
  categoria        String   @default("ADEREZOS")

  insumoId         String?
  insumo           Insumo?  @relation(fields: [insumoId], references: [id])

  preciosPorCategoria ExtraPrecio[]
  categoriasAplica    ExtraCategoria[]
  consumosPorCategoria ExtraConsumo[]
  stockMovimientos     StockMovimiento[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ExtraCategoria {
  id         String @id @default(uuid())
  extraId    String
  categoriaId String

  extra     Extra     @relation(fields: [extraId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([extraId, categoriaId])
}

model ExtraPrecio {
  id          String @id @default(uuid())
  extraId     String
  categoriaId String
  precio      Float @default(0)

  extra     Extra     @relation(fields: [extraId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([extraId, categoriaId])
}

model ExtraConsumo {
  id              String   @id @default(uuid())
  extraId         String
  categoriaId     String
  cantidadConsumo Float    // ej: 30 (g, ml o unidades)

  extra     Extra     @relation(fields: [extraId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([extraId, categoriaId])
}

model Aderezo {
  id               String   @id @default(uuid())
  nombre           String   @unique
  stockActual      Float    @default(0)

  // Nullable en la base por historia, OBLIGATORIA por contrato: el backfill de
  // 20260831000000 dejo todas las filas con valor y los DTOs del panel la
  // exigen de la lista blanca (`UNIDADES_MEDIDA` en src/insumos/unidades.ts).
  // Pendiente aparte: promoverla a NOT NULL.
  unidadMedida String? // g, ml, u, etc.

  // Umbral de aviso PROPIO de la salsa, mismo criterio que Insumo.stockMinimo
  // y Extra.stockMinimo. El default de la columna existe para que la migracion
  // pudiera agregarla NOT NULL sin reescribir la tabla; el alta lo pide
  // obligatorio (ver CrearAderezoDto).
  stockMinimo Float @default(10)

  activo           Boolean  @default(true)
  esGlobal         Boolean  @default(false)

  // ⚠️ DEPRECADA. Las salsas son SIEMPRE GRATIS: no tienen precio ni lo van a
  // tener. La tabla existe con 0 filas y ningun endpoint la lee ni la escribe
  // desde el rework. Queda solo para poder borrarla en una migracion aparte.
  precioPorCategoria   AderezoPrecio[]
  categoriasAplica     AderezoCategoria[]
  detalles             PedidoDetalle[]
  consumosPorCategoria AderezoConsumo[]
  stockMovimientos     StockMovimiento[]
}

model AderezoCategoria {
  id          String @id @default(uuid())
  aderezoId   String
  categoriaId String

  aderezo   Aderezo   @relation(fields: [aderezoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([aderezoId, categoriaId])
}

model AderezoConsumo {
  id              String   @id @default(uuid())
  aderezoId       String
  categoriaId     String
  cantidadConsumo Float    // ej: 40 (g, ml o unidades)

  aderezo   Aderezo   @relation(fields: [aderezoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([aderezoId, categoriaId])
}

// ============================================
// SISTEMA DE OFERTAS
// ============================================

enum TipoOferta {
  DOS_POR_UNO
  COMBO
  DESCUENTO_PORCENTAJE
  DESCUENTO_MONTO_FIJO
}

enum EstadoOferta {
  ACTIVA
  PAUSADA
  VENCIDA
}

model Oferta {
  id                  String          @id @default(uuid())
  nombre              String
  descripcion         String?
  tipo                TipoOferta
  estado              EstadoOferta    @default(ACTIVA)

  fechaInicio         DateTime
  fechaFin            DateTime?
  activa              Boolean         @default(true)

  porcentajeDescuento Float?
  montoDescuento      Float?

  precio              Float?          // Precio fijo del combo
  imagenUrl           String?         // Foto del combo
  orden               Int             @default(0) // Orden de aparición en el menú

  maxUsosPorCliente   Int?
  maxUsosTotales      Int?
  usosActuales        Int             @default(0)

  diasAplicables      String          @default("1,2,3,4,5,6,7")
  horaInicio          String?
  horaFin             String?

  aplicaPorLinea      Boolean         @default(true)

  productos           OfertaProducto[]
  gruposCombo         GrupoCombo[]
  pedidosAplicados    PedidoOferta[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([activa, estado])
  @@index([fechaInicio, fechaFin])
}

model OfertaProducto {
  id            String    @id @default(uuid())
  ofertaId      String
  productoId    String
  obligatorio   Boolean   @default(false)
  cantidadMin   Int       @default(1)
  cantidadMax   Int?
  precioEspecial Float?
  orden         Int       @default(0) // Orden de los modales (qué producto se arma primero)

  oferta        Oferta    @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  producto      Producto  @relation(fields: [productoId], references: [id])

  @@unique([ofertaId, productoId, orden])
}

// DEPRECADO — reemplazado por OfertaProducto ordenado (lista fija). No usar en código nuevo.
// Se mantiene en el schema para preservar las tablas existentes (evitar DROP TABLE).
model GrupoCombo {
  id            String        @id @default(uuid())
  ofertaId      String
  nombre        String
  obligatorio   Boolean       @default(true)
  cantidad      Int           @default(1)

  oferta        Oferta        @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  opciones      GrupoOpcion[]
}

// DEPRECADO — ver nota en GrupoCombo. No usar en código nuevo.
model GrupoOpcion {
  id            String      @id @default(uuid())
  grupoComboId  String
  productoId    String

  grupoCombo    GrupoCombo  @relation(fields: [grupoComboId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [id])

  @@unique([grupoComboId, productoId])
}

model PedidoOferta {
  id String @id @default(uuid())
  pedidoId String
  ofertaId String
  pedidoDetalleId String? @unique

  precioOriginal Float
  precioFinal Float
  descuentoAplicado Float

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  oferta Oferta @relation(fields: [ofertaId], references: [id])
  pedidoDetalle PedidoDetalle? @relation(fields: [pedidoDetalleId], references: [id])

  @@index([pedidoId])
  @@index([ofertaId])
}

// ⚠️ TABLA MUERTA / A DEPRECAR. Las salsas son siempre gratis (decision de
// producto): no se cobran por categoria ni de ninguna otra forma. La tabla
// tiene 0 filas y nadie la lee ni la escribe. Se conserva solo para poder
// borrarla en una migracion propia; NO agregar codigo nuevo que la use.
model AderezoPrecio {
  id String @id @default(uuid())
  aderezoId String
  categoriaId String
  precio Float @default(0)

  aderezo Aderezo @relation(fields: [aderezoId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([aderezoId, categoriaId])
}

enum TipoMovimientoCaja {
  ENTRADA
  SALIDA
  AJUSTE
}

model CajaMovimiento {
  id String @id @default(uuid())
  pedidoId String?
  tipo TipoMovimientoCaja
  montoTotal Float
  gananciaNegocio Float
  gananciaRepartidor Float
  descripcion String?

  /**
   * Nombre de quien registro el movimiento, congelado en el momento de
   * escribirlo. NO es la fuente de verdad de la autoria: es un snapshot para
   * que el historico siga siendo legible si el usuario se renombra o se borra.
   * Quien pregunta "quien cobro esto" tiene que mirar `registradoPorId`.
   * Hasta esta migracion era TODO lo que habia, y encima llegaba del body de
   * la request: el front mandaba los literales 'Admin' y 'POS', y cualquiera
   * podia mandar el nombre que quisiera. Las filas viejas conservan eso.
   */
  confirmadoPor String?

  /**
   * Quien registro el movimiento, de verdad. Sale SIEMPRE del JWT
   * (`req.user.sub`), nunca del body.
   * Null en dos casos: las filas anteriores a esta migracion (el dato no es
   * reconstruible: 'Admin'/'POS' no identifican a nadie) y las que pierden a
   * su usuario, porque la FK es SET NULL a proposito — borrar un empleado no
   * puede borrar ni bloquear el historico de caja. En los dos casos queda
   * `confirmadoPor` como unico rastro.
   */
  registradoPorId String?
  registradoPor   User?   @relation("MovimientosRegistrados", fields: [registradoPorId], references: [id], onDelete: SetNull)

  fechaConfirmacion DateTime?
  createdAt DateTime @default(now())

  pedido Pedido? @relation(fields: [pedidoId], references: [id])

  /**
   * LA defensa contra el doble cobro. Antes lo unico que impedia cobrar dos
   * veces el mismo pedido era un findFirst adentro de la transaccion, y con
   * Postgres en READ COMMITTED eso no alcanza: dos confirmaciones concurrentes
   * del mismo pedido leen "no hay movimiento" las dos y las dos insertan. La
   * venta terminaba contada dos veces en el resumen.
   * Es (pedidoId, tipo) y no pedidoId solo por dos razones:
   * 1. Deja lugar a una SALIDA sobre el mismo pedido (una devolucion) sin
   * chocar con su ENTRADA, que es lo unico que hay que impedir.
   * 2. Con `pedidoId` solo, Prisma leeria la relacion como 1-1 y obligaria a
   * cambiar `Pedido.movimientosCaja` de lista a objeto, rompiendo el
   * `movimientosCaja: { none: ... }` de pedidos y el `.some(...)` del
   * front. Sumar `tipo` la mantiene 1-N.
   * Los movimientos manuales (pedidoId null) no se ven afectados: en Postgres
   * una UNIQUE con NULL adentro no colisiona nunca (NULLS DISTINCT), asi que
   * se pueden registrar todos los gastos que haga falta.
   */
  @@unique([pedidoId, tipo])
  // La tabla no tenia NINGUN indice. Los dos cubren los dos patrones reales:
  // filtrar solo por fecha (lista de movimientos del Home, "mejor dia" del
  // periodo) y filtrar por tipo dentro de un rango (getResumenAgregado).
  // El compuesto no reemplaza al simple: con `tipo` sin restringir no aplica.
  @@index([fechaConfirmacion])
  @@index([tipo, fechaConfirmacion])
}

// --- CONFIGURACIÓN DEL NEGOCIO ---

model Configuracion {
  id          String   @id @default(uuid())
  clave       String   @unique // Ej: "alias_transferencia", "whatsapp_numero"
  valor       String // Ej: "after.panch", "+5491123456789"
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Horario de atencion, una fila por dia de la semana.
 * Antes el horario era GLOBAL: dos claves sueltas en "Configuracion"
 * ('hora_apertura' / 'hora_cierre') que regian de lunes a domingo por igual.
 * Un local que abre 12:00 los sabados y 19:00 el resto no se podia expresar.
 * `dia` es 0=Lunes ... 6=Domingo. NO es el indice de Date#getDay (que arranca
 * en domingo): la conversion es `(getDay() + 6) % 7` y vive en
 * NegocioConfigService.momentoLocal.
 * `desde`/`hasta` son "HH:MM" en hora local del negocio (America/Argentina/
 * Mendoza). Se guardan como texto y no como minutos porque es lo que hablan
 * los dos extremos: el <input type="time"> del panel y el cartel del menu.
 * El formato lo garantizan el @Matches del DTO y el regex de la migracion.
 * CRUZA MEDIANOCHE: cuando `hasta` <= `desde` el turno termina al dia
 * siguiente (abre 19:00, cierra 00:30). Eso hace que para saber si el local
 * esta abierto AHORA no alcance con mirar hoy: hay que mirar tambien si sigue
 * corriendo el turno de ayer. La regla completa esta en
 * NegocioConfigService.estaAbierto.
 */
model HorarioDia {
  id        String   @id @default(uuid())
  dia       Int      @unique // 0=Lunes ... 6=Domingo
  abierto   Boolean  @default(true)
  desde     String   @db.VarChar(5) // "HH:MM"
  hasta     String   @db.VarChar(5) // "HH:MM"
  updatedAt DateTime @updatedAt
}

model Barrio {
  id          String   @id @default(uuid())
  nombre      String   @unique
  precioEnvio Float    @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- SISTEMA DE ENVÍOS ---

enum ShippingMode {
  RADIUS
  POLYGON
  RADIUS_TIERS
}

model ShippingConfig {
  id                   String       @id @default(uuid())
  mode                 ShippingMode @default(RADIUS)
  localLat             Float
  localLng             Float
  radiusKm             Float        @default(5)
  radiusPrice          Float        @default(0)
  maxDeliveryRadiusKm  Float        @default(10)
  borderToleranceMeters Int         @default(500)
  updatedAt            DateTime     @updatedAt
}

model ShippingZone {
  id        String   @id @default(uuid())
  name      String
  price     Float
  polygon   Json     // GeoJSON: { type: "Polygon", coordinates: [[[lng,lat],...]] }
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeocodingCache {
  id String @id @default(uuid())
  normalizedKey String @unique
  formattedAddress String
  lat Float
  lng Float
  importance Float @default(1)
  precision String @default("exact")
  hitCount Int @default(1)
  createdAt DateTime @default(now())
  lastUsedAt DateTime @updatedAt
  expiresAt DateTime?

  @@index([normalizedKey])
  @@index([expiresAt])
}

model ShippingRadiusTier {
  id        String   @id @default(uuid())
  fromKm    Float
  toKm      Float
  price     Float
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}